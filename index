<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Painel de Controladoria - Mini DRE</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <style>
    body { background-color: #f4f6f8; font-family: 'Segoe UI', Arial, sans-serif; }
    h1 { color: #2c3e50; margin-top: 30px; }
    .card { box-shadow: 0 2px 6px rgba(0,0,0,0.1); border: none; }
    .chart-container { position: relative; height: 250px; }
  </style>
</head>
<body>
  <div class="container text-center">
    <h1>📊 Painel de Controladoria</h1>
    <p class="text-muted">Indicadores financeiros e Mini DRE</p>

    <!-- Linha 1: Receita, Custos, Lucro Bruto -->
    <div class="row mt-4">
      <div class="col-md-4">
        <div class="card p-3">
          <h5>Receita Líquida</h5>
          <div class="chart-container"><canvas id="receita"></canvas></div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card p-3">
          <h5>Custos Operacionais</h5>
          <div class="chart-container"><canvas id="custos"></canvas></div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card p-3">
          <h5>Lucro Bruto</h5>
          <div class="chart-container"><canvas id="lucroBruto"></canvas></div>
        </div>
      </div>
    </div>

    <!-- Linha 2: Despesas, EBIT, Fluxo de Caixa -->
    <div class="row mt-4">
      <div class="col-md-4">
        <div class="card p-3">
          <h5>Despesas Administrativas</h5>
          <div class="chart-container"><canvas id="despesas"></canvas></div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card p-3">
          <h5>EBIT</h5>
          <div class="chart-container"><canvas id="ebit"></canvas></div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card p-3">
          <h5>Fluxo de Caixa</h5>
          <div class="chart-container"><canvas id="fluxo"></canvas></div>
        </div>
      </div>
    </div>

    <!-- Linha 3: Endividamento, ROI, Margem Líquida -->
    <div class="row mt-4">
      <div class="col-md-4">
        <div class="card p-3">
          <h5>Endividamento</h5>
          <div class="chart-container"><canvas id="endividamento"></canvas></div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card p-3">
          <h5>ROI</h5>
          <div class="chart-container"><canvas id="roi"></canvas></div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card p-3">
          <h5>Margem Líquida</h5>
          <div class="chart-container"><canvas id="margem"></canvas></div>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Receita Líquida
    new Chart(document.getElementById('receita'), {
      type: 'bar',
      data: { labels: ['Jan','Fev','Mar','Abr'], datasets:[{label:'Receita (R$)',data:[200000,220000,250000,270000],backgroundColor:'#3498db'}] }
    });

    // Custos Operacionais
    new Chart(document.getElementById('custos'), {
      type: 'pie',
      data: { labels: ['Pessoal','Materiais','Serviços'], datasets:[{data:[80000,40000,30000],backgroundColor:['#e67e22','#1abc9c','#9b59b6']}] }
    });

    // Lucro Bruto
    new Chart(document.getElementById('lucroBruto'), {
      type: 'line',
      data: { labels: ['Jan','Fev','Mar','Abr'], datasets:[{label:'Lucro Bruto (R$)',data:[120000,140000,150000,160000],borderColor:'#2ecc71',fill:false}] }
    });

    // Despesas Administrativas
    new Chart(document.getElementById('despesas'), {
      type: 'bar',
      data: { labels: ['RH','TI','Marketing'], datasets:[{label:'Despesas (R$)',data:[20000,15000,10000],backgroundColor:'#e74c3c'}] }
    });

    // EBIT
    new Chart(document.getElementById('ebit'), {
      type: 'doughnut',
      data: { labels: ['EBIT','Outros'], datasets:[{data:[45000,155000],backgroundColor:['#27ae60','#bdc3c7']}] }
    });

    // Fluxo de Caixa
    new Chart(document.getElementById('fluxo'), {
      type: 'bar',
      data: { labels: ['Entradas','Saídas'], datasets:[{label:'Fluxo (R$)',data:[180000,140000],backgroundColor:['#2ecc71','#e74c3c']}] }
    });

    // Endividamento
    new Chart(document.getElementById('endividamento'), {
      type: 'radar',
      data: { labels: ['Curto Prazo','Longo Prazo','Garantias'], datasets:[{label:'Endividamento (%)',data:[30,15,10],backgroundColor:'rgba(52,152,219,0.3)',borderColor:'#2980b9'}] }
    });

    // ROI
    new Chart(document.getElementById('roi'), {
      type: 'line',
      data: { labels: ['Jan','Fev','Mar','Abr'], datasets:[{label:'ROI (%)',data:[18,20,22,25],borderColor:'#f1c40f',fill:false}] }
    });

    // Margem Líquida
    new Chart(document.getElementById('margem'), {
      type: 'bar',
      data: { labels: ['Jan','Fev','Mar','Abr'], datasets:[{label:'Margem Líquida (%)',data:[12,14,15,16],backgroundColor:'#8e44ad'}] }
    });
  </script>
</body>
</html>
